# Normally stored by `mmco setup` in ~/.config/mmco/.env; a ./.env in the working directory overrides it.
OPENROUTER_API_KEY=sk-or-v1-...

# Planner (any OpenAI-compatible endpoint works)
MMCO_PLANNER_MODEL=deepseek/deepseek-v4.1-flash
MMCO_PLANNER_BASE_URL=https://openrouter.ai/api/v1
MMCO_PLANNER_TEMPERATURE=0.2
# Set to false if the provider rejects response_format={"type": "json_object"}
MMCO_PLANNER_JSON_MODE=true
MMCO_PLANNER_MAX_RETRIES=3
MMCO_PLANNER_TIMEOUT_SECONDS=180

# Executor (Claude Code). Shell aliases are invisible to subprocesses: use a real path if needed.
MMCO_CLAUDE_BINARY=claude
# MMCO_CLAUDE_MODEL=sonnet
MMCO_CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep
MMCO_CLAUDE_PERMISSION_MODE=acceptEdits
MMCO_CLAUDE_TIMEOUT_SECONDS=900
# MMCO_CLAUDE_MAX_BUDGET_USD_PER_TASK=2.0
# What Claude is told by default (full | task | minimal); a rules.md front matter overrides it (`mmco rules`)
MMCO_EXECUTOR_CONTEXT=full

# Loop limits
MMCO_MAX_ATTEMPTS_PER_TASK=3
MMCO_MAX_REFORMULATIONS_PER_TASK=2
MMCO_MAX_SUBTASKS_PER_TASK=5
MMCO_MAX_LOOP_ITERATIONS=100
# MMCO_MAX_SESSION_COST_USD=20
MMCO_STOP_ON_TASK_FAILURE=true
MMCO_VERIFY_TIMEOUT_SECONDS=300
# Ask you (guidance / skip / abort) instead of failing a stuck task
MMCO_ESCALATE_TO_USER=true
# Rerun all checks and compare the result with the request before finishing
MMCO_FINAL_REVIEW=true
MMCO_MAX_FINAL_REVIEWS=2
# Rerun earlier tasks' checks after every task
MMCO_REGRESSION_CHECKS=true
# Claude API overload / rate limits: retries without spending attempts
MMCO_MAX_TRANSIENT_RETRIES=4
MMCO_TRANSIENT_BACKOFF_SECONDS=30

# State
MMCO_GIT_CHECKPOINTS=true
MMCO_DB_PATH=~/.mmco/mmco.db
MMCO_LOG_DIR=~/.mmco/logs
MMCO_LOG_LEVEL=INFO
# Extra prompt override folder (project and global overrides: `mmco prompts --eject`)
# MMCO_PROMPTS_DIR=./my-prompts
